         <div type="edition" xml:lang="omy-Latn" rendition="class:38769 maturity:83213">
<p><lb n="1"/><g ref="sym:doubleBar" type="punctuation">.</g> śrī svasti śaka-varṣātīta <num value="714">714</num> kārttika-māsa caturddaśi śukla-pakṣa śukra<lb n="2" break="no"/>-vāra vās· pon· 
tatkālaṇḍa daṁ nāyaka di raṇḍa lūravaṁ  nāmaṇḍa maṁdr̥ṣṭi  diṁ <lb n="3"/>vajrāsana mañjuśrīgr̥ha nāmāñaṁ  prāsāda tlas· sida  maṁdr̥ṣṭi mañamvaḥ <lb n="4"/>sida di  daṁ hyaṁ daśadiśa li<unclear>kh</unclear>ita  yaṁ praṇidhānaṇḍa  (naras samanta punta<!-- ā? --> rān·) <g ref="sym:doubleBar" type="punctuation">.</g></p>
<lg met="anuṣṭubh" n="1">
<l n="a">pha<lb n="5" break="no"/>lāṅku maṁmaṅgap·  puṇya</l> <l n="b">diṁ janmeni paratra lai</l>
<l n="c">kalpavr̥kṣa muAḥ  Āku</l> <l n="d">diṁ <lb n="6"/> jagat· sacarācara (||)</l>
</lg> 
<lg met="anuṣṭubh" n="2">
<l n="a">sarvvasatvopajīvyāku</l>  <l n="b">sarvvasatvekanāya<lb n="7" break="no"/>ka</l>
<l n="c">sarvvasatvaparitrātā</l>  <l n="d">sarvvasatvekavāndhava ||</l></lg>
<lg met="anuṣṭubh" n="3">
<l n="a">praṇidh(ī)ni  mahā<lb n="8" break="no"/>tyanta</l> <l n="b">śraddhāvega-samudgata</l> 
<l n="c">mañjuśrīgr̥ha samumbhr̥ta</l>  <l n="d">sarvva-śrī-sukha<lb n="9" break="no"/>-(bh)ājana</l></lg>
<lg met="anuṣṭubh" n="4">
<l n="a">prāsādeni kumaṅgap· ya</l> <l n="b">puṇyāṇḍa śrī nareśvara</l>
<l n="c">Iha-janma para<lb n="10" break="no"/>trāku</l>  <l n="d">jaṅan·  sārak· daṅan· sida  ||</l></lg>
<lg met="anuṣṭubh" n="5">
<l n="a">Ini janma kūminta  ya</l>  <l n="b">nissāra ka<lb n="11" break="no"/>dalī (d)iga</l>
<l n="c">Ājñā narendra sārāña</l>  <l n="d">(pr̥ṣṭaṁ)  ⏓ ⏓ jagattraya  ||</l>
</lg>
<lg met="anuṣṭubh" n="6">
<l n="a">Ājñā<lb n="12" break="no"/>ṇḍa kuju<unclear>ṁ</unclear>juṁ nitya</l><l n="b">diṁ janmeni paratra lai</l>
<l n="c">(v)araṁ  kāryya  mahābhāra</l> <l n="d"><lb n="13"/>Āku mūAḥ susārathi <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
<lg met="anuṣṭubh" n="7">
