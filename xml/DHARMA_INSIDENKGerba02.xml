        <lb n="2"/>yaṁ <unclear>ma</unclear>m<supplied reason="lost">i</supplied> <supplied reason="lost">g</supplied>u<supplied reason="lost">r</supplied>u-<supplied reason="lost">g</supplied>u<supplied reason="lost">r</supplied>u y<unclear>e</unclear><lb n="3" break="no"/>n arabi donan ika de<lb n="4" break="no"/>n· kadi botiṅ akasa
